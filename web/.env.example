APP_URL=http://localhost:4173
PORT=4173
HOST=127.0.0.1
# Set exact proxy IP/CIDR only after configuring the reverse proxy.
TRUSTED_PROXY=
NODE_ENV=development
# Generate locally: openssl rand -base64 48
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/accounts.sqlite
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Product photos — server only. See docs/PHOTO-STUDIO.md.
FASHN_API_KEY=
# HTTPS images of the SAME reference model, front and back respectively.
PHOTO_MODEL_FRONT=
PHOTO_MODEL_BACK=
# Maximum paid generation attempts for the entire shop per rolling 24 hours.
PHOTO_DAILY_LIMIT=30
# Optional proxy ONLY for FASHN. HTTP CONNECT or socks5; URL-encode credentials.
# With a proxy, product and bundled model images are sent inline (no shop downloads).
FASHN_PROXY_URL=

# Optional male model overrides. Defaults: bundled man-front-v1.png / man-back-v1.png.
PHOTO_MODEL_MALE_FRONT=
PHOTO_MODEL_MALE_BACK=

# Address suggestions — server only; leave empty for manual address entry.
DADATA_API_KEY=
